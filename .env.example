# MCPBlueprint Environment Variables
# Copy this file to .env for local development.
# On Vercel, set these in your project's Environment Variables dashboard.
# NEVER commit a .env file with real values to source control.

# ── Admin Panel ───────────────────────────────────────────────────────────────

# Port for local development (Vercel sets its own port automatically)
PORT=3000

# Optional secret to gate admin panel access.
# Pass as X-Admin-Secret header. Leave blank to disable auth (not recommended for public deployments).
ADMIN_SECRET=

# ── Internal Auth ─────────────────────────────────────────────────────────────

# Shared bearer token used for all internal agent-to-agent calls.
# Required. Guardrail agent will refuse to start without this.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_AGENT_TOKEN=

# ── Guardrail ─────────────────────────────────────────────────────────────────

# Operating mode. 'alert' logs and notifies. 'intervene' can block or reroute.
# Start with 'alert'. Switch to 'intervene' after validating your rule set.
GUARDRAIL_MODE=alert

# Webhook URL where the guardrail and event-driven agents send alerts.
# Works with Slack, PagerDuty, or any webhook receiver. Leave blank to disable external alerts.
ALERT_WEBHOOK_URL=

# Number of alerts within 60 seconds before severity escalates. Default: 5.
ESCALATION_THRESHOLD=5

# ── Event-Driven Agent ────────────────────────────────────────────────────────

# Secret used to verify incoming webhook signatures (HMAC-SHA256).
# Must match the secret your webhook source uses to sign payloads.
WEBHOOK_SECRET=

# ── Agent URLs (set per deployed agent) ──────────────────────────────────────
#
# Each active agent needs its deployed Vercel URL set here.
# Format: https://<your-project>.vercel.app/agents/<agent-name>
# Leave blank for agents you haven't activated.

GUARDRAIL_AGENT_URL=
DIRECT_API_WRAPPER_URL=
COMPOSITE_SERVICE_URL=
MCP_TO_AGENT_URL=
EVENT_DRIVEN_AGENT_URL=
CONFIGURATION_USE_AGENT_URL=
ANALYTICS_DATA_ACCESS_URL=
HIERARCHICAL_MCP_URL=
LOCAL_RESOURCE_ACCESS_URL=

# ── Agent API Credentials (customize per agent) ───────────────────────────────
#
# Replace these with the actual API credentials your agents need.
# See each agent's config.example.json for the full list.

# direct-api-wrapper
TARGET_API_ENDPOINT=
TARGET_API_KEY=

# composite-service
USER_PROFILE_API=
USER_PROFILE_API_KEY=
BILLING_API=
BILLING_API_KEY=
ACTIVITY_API=
ACTIVITY_API_KEY=

# analytics-data-access
METRICS_API_URL=
METRICS_API_KEY=
ERROR_TRACKING_API_URL=
ERROR_TRACKING_API_KEY=

# ── File Paths (optional overrides) ──────────────────────────────────────────

# Override where the admin panel reads the platform config.
# Default: ./config/platform.json
# On Vercel, set to /tmp/platform.json to use the writable temp filesystem.
PLATFORM_CONFIG_PATH=

# Override where the admin panel reads the risk profile.
# Default: ./risk-scanner/output/risk-profile.json
# On Vercel, set to /tmp/risk-profile.json if writing scan output there.
RISK_PROFILE_PATH=
